# Configuração somente para teste local no Windows.
# Use a origem mostrada pelo servidor local do detector; normalmente http://localhost:5173.
APP_ORIGIN=http://localhost:5173
STREAM_DOMAIN=nao-usado-no-teste-local

# Substitua somente quando descobrir o IP, a conta e o caminho RTSP da câmera.
CAMERA_RTSP_URL=rtsp://USUARIO_CAMERA:SENHA_CAMERA@192.168.1.50:554/CAMINHO_DO_STREAM

# Contas de leitura do HLS local. Não reutilize a senha administrativa da câmera.
STREAM_USER_1=teste
STREAM_PASS_1=troque-esta-senha
STREAM_USER_2=operador
STREAM_PASS_2=troque-esta-outra-senha
