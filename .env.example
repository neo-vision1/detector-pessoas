# URL base do aplicativo local ou publicado (opcional).
APP_URL="http://localhost:3000"

# Controle PTZ ONVIF da câmera IP. Nunca exponha estas credenciais no navegador.
# Deixe como false para desativar todos os comandos PTZ pelo servidor.
CAMERA_PTZ_ENABLED=false
CAMERA_ONVIF_HOST=192.168.15.2
CAMERA_ONVIF_USERNAME=usuario_onvif
CAMERA_ONVIF_PASSWORD=senha_onvif
CAMERA_ONVIF_PORT=80
