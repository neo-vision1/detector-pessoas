# Domínio público HTTPS que apontará para este gateway.
STREAM_DOMAIN=stream.exemplo.com
# Origem autorizada do painel do detector, incluindo protocolo.
APP_ORIGIN=https://app.exemplo.com

# URL RTSP local da Intelbras. Use H.264 no stream da câmera para maior compatibilidade.
# Exemplo ilustrativo; substitua pelo endereço real da câmera.
CAMERA_RTSP_URL=rtsp://USUARIO_CAMERA:SENHA_CAMERA@192.168.1.50:554/caminho-do-stream

# Usuários individuais que terão permissão somente de leitura do stream.
STREAM_USER_1=operador
STREAM_PASS_1=troque-por-uma-senha-forte
STREAM_USER_2=supervisor
STREAM_PASS_2=troque-por-outra-senha-forte
